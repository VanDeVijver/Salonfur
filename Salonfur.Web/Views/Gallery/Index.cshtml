@model IReadOnlyList<AlbumViewModel>
@{
    ViewData["Title"] = "Albums";
}
<section class="page gallery-page">
  <div class="wrap">
    <p class="label">albums</p>
    <h1>Uit de <i>salon</i></h1>

    @if (Model.Count == 0)
    {
      <p>Er staan nog geen albums online. Kijk intussen eens op <a href="@SalonInfo.InstagramUrl" target="_blank" rel="noopener">instagram ↗</a></p>
    }
    else
    {
      <div class="album-cards">
        @foreach (var a in Model)
        {
          <a class="album-card" href="/albums/@a.Id">
            <img src="/fotos/@a.PhotoIds[0]" loading="lazy" alt="">
            <h2>@a.Title</h2>
            @if (!string.IsNullOrWhiteSpace(a.Description)) { <p>@a.Description</p> }
            <span class="count">@a.PhotoIds.Count foto@(a.PhotoIds.Count == 1 ? "" : "'s")</span>
          </a>
        }
      </div>
    }
  </div>
</section>
