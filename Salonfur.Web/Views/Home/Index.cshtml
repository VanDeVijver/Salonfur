@model HomeViewModel
@{
    var sizes = new (DogSize Size, string Label, string Weight, string Path, int Height)[]
    {
        (DogSize.Mini, "mini", "< 5 kg", "M8 14c0-4 4-6 10-6h10l4-4 3 3-2 4v7h-3v-4H14v4h-3v-4c-2 0-3-1-3-0z", 16),
        (DogSize.Klein, "klein", "5 – 10 kg", "M6 12c0-4 4-6 10-6h12l4-4 3 3-2 4v10h-3v-6H13v6h-3v-6c-2 0-4-1-4-1z", 20),
        (DogSize.Middel, "middel", "10 – 25 kg", "M5 11c0-4 4-6 10-6h13l4-4 3 3-2 4v15h-3V16H13v7h-3v-7c-3 0-5-2-5-5z", 24),
        (DogSize.Groot, "groot", "> 25 kg", "M4 10c0-4 4-7 11-7h13l4-3 4 3-2 5v18h-4V16H13v10H9V16c-3 0-5-3-5-6z", 28),
    };
    var band = new[] { "wassen & föhnen", "trimmen", "plukken", "nagels knippen", "puppy-kennismaking", "wiener time" };
}

<div class="hero"><div class="wrap">
  <div>
    <p class="label">hondentrimsalon · oosterzele</p>
    <h1>salon<span class="dot">.</span>fur<i>grooming met een eigen stijl</i></h1>
    <p class="lead">Wassen, trimmen en plukken in een rustige, lichte salon tussen het groen. Elke hond krijgt de tijd, en gaat fris, zacht en een beetje cooler naar huis.</p>
    <div class="hero-actions">
      <a class="btn" href="#afspraak">Plan een beurt →</a>
      <a class="btn btn-l" href="#voor-na">Bekijk voor &amp; na</a>
    </div>
    <div class="where">
      <div><b>@SalonInfo.Street</b>@SalonInfo.City</div>
      <div><b>Enkel op afspraak</b>één hond tegelijk</div>
    </div>
  </div>
  <div class="photo-wrap">
    <div class="photo"><img src="~/img/eigenares.jpg" width="470" height="588" alt="De eigenares van salon.fur met haar windhond, allebei met een blauw geruite hoofddoek"></div>
    <div class="sticker"><b>how's that heatwave going?</b>@@salon.fur</div>
    <div class="sticker2" aria-hidden="true">punk's<br>not<br>dead ✦</div>
  </div>
</div></div>

<div class="band" aria-hidden="true"><div>
  @for (var i = 0; i < 2; i++) { foreach (var item in band) { <span>@item</span> } }
</div></div>

<section class="about" id="over"><div class="wrap">
  <div>
    <p class="label">over salon.fur</p>
    <h2>Een salon waar honden <i>graag</i> komen</h2>
  </div>
  <div>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus posuere velit aliquet. Maecenas faucibus mollis interdum, vestibulum id ligula porta felis euismod semper.</p>
    <p>Donec ullamcorper nulla non metus auctor fringilla. Cras mattis consectetur purus sit amet fermentum. Nullam quis risus eget urna mollis ornare vel eu leo.</p>
    <div class="notes">
      <div><b>één hond</b><span>tegelijk, dus rust en volle aandacht</span></div>
      <div><b>op maat</b><span>van ras, vacht en karakter</span></div>
    </div>
  </div>
</div></section>

<section id="diensten"><div class="wrap">
  <div class="s-head">
    <div><p class="label">diensten</p><h2>Wat we <i>doen</i></h2></div>
    <p>De prijs hangt af van grootte, vacht en hoe het vel erbij ligt. Je krijgt altijd vooraf een richtprijs.</p>
  </div>
  <div class="svcs">
    @foreach (var s in Model.Services)
    {
      <article class="svc @(s.IsFeatured ? "feature" : null)">
        @if (!string.IsNullOrWhiteSpace(s.Tag)) { <span class="tag">@s.Tag</span> }
        <h3>@s.Name</h3>
        <p>@s.Description</p>
        <div class="price">@s.PriceLabel<b>@s.Price</b></div>
      </article>
    }
  </div>
</div></section>

<section class="ba" id="voor-na"><div class="wrap">
  <p class="label">voor &amp; na</p>
  <h2>Wiener <i>time</i></h2>
  <div class="ba-grid">
    <figure class="shot" style="margin:0"><img src="~/img/teckel-voor.jpg" loading="lazy" alt="Ruwharige teckel voor de beurt, met een lange, pluizige vacht"><span class="pill">voor</span></figure>
    <div class="arrow" aria-hidden="true"><svg viewBox="0 0 26 26"><path d="M5 13h16M15 7l6 6-6 6"/></svg></div>
    <figure class="shot after" style="margin:0"><img src="~/img/teckel-na.jpg" loading="lazy" alt="Dezelfde teckel na het plukken, met een korte, nette vacht"><span class="pill">na</span></figure>
  </div>
  <div class="ba-cap">
    <span><b>Ruwharige teckel, geplukt.</b> Van pluizenbol naar strak en fris.</span>
    <a href="@SalonInfo.InstagramUrl" target="_blank" rel="noopener">meer op instagram ↗</a>
  </div>
</div></section>

<section class="reviews" id="reviews"><div class="wrap">
  <div>
    <p class="label">reviews</p>
    <h2>Wat baasjes <i>zeggen</i></h2>
  </div>
  <div class="card">
    <div class="stars" aria-hidden="true">★★★★★</div>
    <p>Lees hoe andere honden en hun baasjes hun bezoek aan salon.fur ervaren. Was je zelf al langs? Een korte review op Google helpt ons enorm.</p>
    <div class="hero-actions">
      <a class="btn" href="@SalonInfo.ReviewUrl" target="_blank" rel="noopener">Schrijf een review ↗</a>
      <a class="btn btn-l" href="@SalonInfo.ReviewUrl" target="_blank" rel="noopener">Lees de reviews op Google ↗</a>
    </div>
  </div>
</div></section>

<section class="book" id="afspraak"><div class="wrap">
  <div>
    <p class="label">afspraak maken</p>
    <h2>Boek een <i>beurt</i></h2>
    <p class="lead">Vertel iets over je hond en kies een vrij moment. Je afspraak staat meteen in onze agenda.</p>
    <ul>
      <li>Eerste keer? Reken op wat extra tijd om kennis te maken.</li>
      <li>Laat je hond vooraf even plassen en wandelen.</li>
      <li>Oudere hond of gevoelige huid? Zet het bij de opmerkingen.</li>
      <li>Liever bellen? @SalonInfo.Phones[0].Display</li>
    </ul>
  </div>

  <form class="form-card" id="booking-form" asp-controller="Home" asp-action="Book" asp-fragment="afspraak" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <p class="fs"><b>1</b>je hond</p>
    <div class="row">
      <div>
        <label>Naam van je hond<input asp-for="Booking.DogName" placeholder="bv. Punk" autocomplete="off"></label>
        <span asp-validation-for="Booking.DogName" class="field-error"></span>
      </div>
      <div>
        <label>Ras<input asp-for="Booking.Breed" placeholder="bv. ruwharige teckel" autocomplete="off"></label>
        <span asp-validation-for="Booking.Breed" class="field-error"></span>
      </div>
    </div>
    <fieldset>
      <legend class="legend">Grootte</legend>
      <div class="sizes">
        @foreach (var size in sizes)
        {
          <label><input type="radio" asp-for="Booking.Size" value="@size.Size" id="size-@size.Size"><span><svg viewBox="0 0 40 26" style="height:@(size.Height)px" aria-hidden="true"><path d="@size.Path"/></svg>@size.Label<small>@size.Weight</small></span></label>
        }
      </div>
      <span asp-validation-for="Booking.Size" class="field-error"></span>
    </fieldset>

    <p class="fs"><b>2</b>de beurt</p>
    <fieldset>
      <legend class="legend">Wat mag het zijn?</legend>
      <div class="pick" id="service-pick">
        @foreach (var s in Model.BookableServices)
        {
          <label><input type="radio" asp-for="Booking.ServiceId" value="@s.Id" id="service-@s.Id" data-duration="@s.DurationMinutes"><span>@s.Name</span></label>
        }
      </div>
      <span asp-validation-for="Booking.ServiceId" class="field-error"></span>
    </fieldset>
    <label>Dag<input asp-for="Booking.Date" type="date" min="@Model.MinDate.ToString("yyyy-MM-dd")" max="@Model.MaxDate.ToString("yyyy-MM-dd")"></label>
    <span asp-validation-for="Booking.Date" class="field-error"></span>
    <fieldset>
      <legend class="legend">Tijdstip</legend>
      <div class="pick slots" id="slots" aria-live="polite" data-url="/afspraak/tijden" data-selected="@Model.Booking.StartTime?.ToString("HH:mm")">
        <p class="hint">Kies eerst een beurt en een dag. Open op donderdag, vrijdag en zaterdagvoormiddag.</p>
      </div>
      <span asp-validation-for="Booking.StartTime" class="field-error"></span>
    </fieldset>
    <label class="check"><input asp-for="Booking.FirstVisit">Mijn hond komt voor het eerst naar salon.fur</label>

    <p class="fs"><b>3</b>jouw gegevens</p>
    <div class="row">
      <div>
        <label>Jouw naam<input asp-for="Booking.CustomerName" autocomplete="name"></label>
        <span asp-validation-for="Booking.CustomerName" class="field-error"></span>
      </div>
      <div>
        <label>GSM<input asp-for="Booking.Phone" type="tel" autocomplete="tel"></label>
        <span asp-validation-for="Booking.Phone" class="field-error"></span>
      </div>
    </div>
    <label>E-mail <span style="font-weight:400;color:var(--muted)">(optioneel)</span><input asp-for="Booking.Email" type="email" autocomplete="email"></label>
    <span asp-validation-for="Booking.Email" class="field-error"></span>
    <label>Opmerkingen<textarea asp-for="Booking.Remarks" rows="3" placeholder="Karakter, gezondheid, gewenste lengte…"></textarea></label>
    <span asp-validation-for="Booking.Remarks" class="field-error"></span>
    <div class="hp" aria-hidden="true"><label>Website<input asp-for="Booking.Website" tabindex="-1" autocomplete="off"></label></div>
    <button class="btn" type="submit">Verstuur afspraak →</button>
    <p style="font-size:13.5px;color:var(--muted);margin:14px 0 0">We gebruiken je gegevens enkel voor deze afspraak. Zie onze <a href="/privacy">privacyverklaring</a>.</p>
  </form>
</div></section>

<section class="contact" id="contact"><div class="wrap">
  <p class="label">contact</p>
  <h2>Kom <i>langs</i></h2>
  <div class="c-grid">
    <div>
      <h3>Adres</h3>
      <p>@SalonInfo.Street<br>@SalonInfo.City</p>
      <p style="margin-top:10px"><a href="@SalonInfo.RouteUrl" target="_blank" rel="noopener">route ↗</a></p>
    </div>
    <div>
      <h3>Contact</h3>
      <p>
        @foreach (var phone in SalonInfo.Phones)
        {
          <a class="tel" href="@phone.Href">@phone.Display</a><br>
        }
      </p>
      <p style="margin-top:10px"><a href="@SalonInfo.InstagramUrl" target="_blank" rel="noopener">@@salon.fur ↗</a></p>
    </div>
    <div>
      <h3>Uren</h3>
      <table class="hours">
        <caption class="sr-only">Openingsuren</caption>
        <tbody>
          @foreach (var row in SalonInfo.HoursTable)
          {
            <tr><td>@row.Day</td><td>@row.Hours</td></tr>
          }
        </tbody>
      </table>
      <p style="margin-top:10px;font-size:14px">Enkel op afspraak</p>
    </div>
  </div>
  <div class="map" id="map">
    <div class="skeleton" aria-hidden="true"></div>
    <iframe title="Kaart met de ligging van salon.fur, @SalonInfo.Street, @SalonInfo.City" src="@SalonInfo.MapEmbedUrl" loading="lazy" referrerpolicy="no-referrer"></iframe>
  </div>
</div></section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking.js" asp-append-version="true"></script>
}
