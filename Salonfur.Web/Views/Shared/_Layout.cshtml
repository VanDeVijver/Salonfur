<!doctype html>
<html lang="nl">
<head>
    <partial name="_Head" />
</head>
<body>
<a class="skip" href="#main">Naar de inhoud</a>

<header>
  <div class="nav">
    <a class="logo" href="/" aria-label="salon.fur, naar de startpagina"><partial name="_Logo" /></a>
    <nav aria-label="Hoofdmenu">
      <a href="/#over">over</a>
      <a href="/#diensten">diensten</a>
      <a href="/#voor-na">voor &amp; na</a>
      <a href="/#reviews">reviews</a>
      <a href="/#contact">contact</a>
      <a class="btn" href="/#afspraak">afspraak maken</a>
    </nav>
  </div>
</header>

<main id="main">
    @RenderBody()
</main>

<footer>
  <div class="big" aria-hidden="true">salon.fur</div>
  <div class="wrap">
    <span>© @DateTime.UtcNow.Year salon.fur · Oosterzele</span>
    <span class="links"><a href="/privacy">Privacy</a><a href="/admin">Beheer</a></span>
  </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
